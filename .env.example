DATABASE_URL=postgres://user:pass@localhost:5432/unsaid
APP_ORIGIN=https://localhost:3000
DATA_KEY=            # base64 of 32 random bytes: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WS_PORT=4000
WS_URL=wss://localhost:4000
APP_ORIGIN_NOTE=must match the browser origin exactly
RESEND_API_KEY=       # optional; without it emails are printed to the server log
MAIL_FROM=Unsaid <no-reply@yourdomain.com>
UPLOAD_DIR=./uploads
CRON_SECRET=          # long random string; call POST /api/cron every few minutes
VAPID_PUBLIC_KEY=     # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
